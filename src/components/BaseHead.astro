---
import { absUrl, url } from '../utils/url';
import { SITE, AUTHOR, BUSINESS, SERVICE_AREA } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (e.g. BlogPosting). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;


const canonical = new URL(Astro.url.pathname, Astro.site!).href;
const ogImage = absUrl(image);
const fullTitle = title === SITE.title ? title : `${title} | ${AUTHOR.name}`;
const sameAs = [AUTHOR.github, AUTHOR.linkedin, AUTHOR.x].filter(Boolean);

// Sitewide entity graph: who you are, what the business is, what the site is.
// @id values let posts reference these instead of repeating them.
const graph = [
  {
    '@type': 'Person',
    '@id': `${absUrl('/')}#person`,
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    url: absUrl('/about/'),
    homeLocation: { '@type': 'Place', name: AUTHOR.location },
    worksFor: { '@id': `${absUrl('/')}#org` },
    knowsAbout: [
      'Agentic AI',
      'Multi-agent systems',
      'AI-assisted software development',
      'Claude Code',
      'Angular',
      'NestJS',
      'Nx monorepos',
      'iOS development',
    ],
    sameAs,
  },
  {
    '@type': 'Organization',
    '@id': `${absUrl('/')}#org`,
    name: BUSINESS.name,
    url: absUrl('/work-with-me/'),
    logo: absUrl('/favicon.svg'),
    founder: { '@id': `${absUrl('/')}#person` },
    areaServed: SERVICE_AREA,
    sameAs,
  },
  {
    '@type': 'WebSite',
    '@id': `${absUrl('/')}#website`,
    url: absUrl('/'),
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': `${absUrl('/')}#person` },
    inLanguage: 'en-US',
  },
  ...schema,
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="light dark" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={absUrl('/rss.xml')} />

<!-- Open Graph (LinkedIn, Slack, Facebook, iMessage previews) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={absUrl('/about/')} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{AUTHOR.xHandle && <meta name="twitter:creator" content={AUTHOR.xHandle} />}

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
