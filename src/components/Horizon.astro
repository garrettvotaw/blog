---
// "First Light" hero: a sky that matches the real sky over Lawton, OK right now.
// Pure CSS scene + one tiny inline script (no framework, ~1 KB).
// Without JS it renders as dawn. With prefers-reduced-motion it stays still.
---

<section class="horizon" data-phase="dawn" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <div class="stars"></div>
    <div class="moon"></div>
    <div class="sun-track"><div class="sun"><div class="rays"></div></div></div>
    <svg class="ridge ridge-far" viewBox="0 0 1440 220" preserveAspectRatio="none">
      <path d="M0 170 C90 150 150 120 230 128 C300 135 330 98 410 92 C480 87 520 126 600 130 C690 134 720 70 820 62 C900 56 950 110 1030 118 C1110 126 1150 96 1230 100 C1320 105 1380 140 1440 146 L1440 220 L0 220Z" />
    </svg>
    <svg class="ridge ridge-near" viewBox="0 0 1440 220" preserveAspectRatio="none">
      <path d="M0 196 C120 186 200 160 300 166 C380 171 430 150 520 150 C610 150 640 176 740 178 C840 180 900 140 1000 136 C1080 133 1120 166 1210 172 C1300 178 1370 168 1440 170 L1440 220 L0 220Z" />
    </svg>
    <div class="grain"></div>
  </div>

  <div class="wrap horizon-copy">
    <slot />
    <p class="sky-note" hidden></p>
  </div>
</section>

<script is:inline>
  (() => {
    const el = document.currentScript.previousElementSibling;
    const lat = 34.6036, lng = -98.3959, tz = 'America/Chicago';
    const rad = Math.PI / 180, dayMs = 864e5, J1970 = 2440588, J2000 = 2451545, J0 = 0.0009;
    const now = new Date();
    const d = now / dayMs - 0.5 + J1970 - J2000, lw = rad * -lng, phi = rad * lat;
    const n = Math.round(d - J0 - lw / (2 * Math.PI)), ds = J0 + lw / (2 * Math.PI) + n;
    const M = rad * (357.5291 + 0.98560028 * ds);
    const L = M + rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M)) + rad * 102.9372 + Math.PI;
    const dec = Math.asin(Math.sin(rad * 23.4397) * Math.sin(L));
    const eq = 0.0053 * Math.sin(M) - 0.0069 * Math.sin(2 * L);
    const w = Math.acos((Math.sin(rad * -0.833) - Math.sin(phi) * Math.sin(dec)) / (Math.cos(phi) * Math.cos(dec)));
    const noon = J2000 + ds + eq, set = J2000 + J0 + (w + lw) / (2 * Math.PI) + n + eq;
    const toDate = (j) => new Date((j + 0.5 - J1970) * dayMs);
    const rise = toDate(noon - (set - noon)), sunset = toDate(set);
    const min = (a, b) => (a - b) / 6e4;
    const t = now.getTime();
    const phase =
      min(t, rise) < -40 ? 'night' :
      min(t, rise) < 50 ? 'dawn' :
      min(t, sunset) < -50 ? 'day' :
      min(t, sunset) < 40 ? 'dusk' : 'night';
    el.dataset.phase = phase;
    const fmt = (x) => x.toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' });
    const words = { night: "it's night", dawn: "it's dawn", day: "it's daytime", dusk: "it's dusk" };
    const note = el.querySelector('.sky-note');
    note.textContent = `Live sky over Lawton, OK · ${words[phase]} · sunrise ${fmt(rise)}, sunset ${fmt(sunset)}`;
    note.hidden = false;
  })();
</script>
