---
import { url } from '../utils/url';
import { readingMinutes, type Post } from '../utils/posts';

interface Props {
  post: Post;
  /** Heading level for the title: h2 under a page h1, h3 under a section h2. */
  level?: 'h2' | 'h3';
}
const { post, level = 'h2' } = Astro.props;
const { title, description, pubDate, draft } = post.data;
const date = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const minutes = readingMinutes(post.body);
const Heading = level;
---

<!-- The title link stretches over the whole entry, so the card is one click target
     while screen readers hear just the title. -->
<li class="post-item">
  <article>
    <p class="post-meta">
      <time datetime={pubDate.toISOString()}>{date}</time> · {minutes} min read
      {draft && <span class="badge">draft</span>}
    </p>
    <Heading class="post-title"><a href={url(`/blog/${post.id}/`)}>{title}</a></Heading>
    <p class="post-desc">{description}</p>
    <span class="post-read" aria-hidden="true">Read post</span>
  </article>
</li>
