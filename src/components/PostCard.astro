---
import { url } from '../utils/url';
import type { Post } from '../utils/posts';

interface Props {
  post: Post;
  showDescription?: boolean;
}
const { post, showDescription = false } = Astro.props;
const { title, description, pubDate, draft } = post.data;
const shortDate = pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<li>
  <a href={url(`/blog/${post.id}/`)}>
    <span class="row-title">
      <span class="t">{title}</span>{draft && <span class="badge">draft</span>}
      {showDescription && <span class="row-desc">{description}</span>}
    </span>
    <time class="row-meta" datetime={pubDate.toISOString()}>{shortDate}</time>
  </a>
</li>
