---
import { url } from '../utils/url';
import { SITE, AUTHOR } from '../consts';

const socials = [
  { href: AUTHOR.github, label: 'GitHub' },
  { href: AUTHOR.linkedin, label: 'LinkedIn' },
  { href: AUTHOR.x, label: 'X' },
  { href: url('/rss.xml'), label: 'RSS' },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>© {new Date().getFullYear()} {SITE.name} · {AUTHOR.location}<span class="clock" data-tz="America/Chicago"></span></p>
    <ul>
      {socials.map(({ href, label }) => (
        <li><a href={href} rel={href.startsWith('http') ? 'me noopener' : undefined}>{label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<script is:inline>
  // Local time in Lawton, ticking. Pure enhancement: nothing shows without JS.
  (() => {
    const el = document.querySelector('.clock');
    if (!el) return;
    const fmt = new Intl.DateTimeFormat('en-US', { timeZone: el.dataset.tz, hour: 'numeric', minute: '2-digit' });
    const tick = () => (el.textContent = ' · ' + fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  })();
</script>
