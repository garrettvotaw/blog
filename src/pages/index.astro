---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPosts } from '../utils/posts';
import { SITE } from '../consts';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="wrap hero">
    <p class="eyebrow">Garrett Votaw · Sunrise Development</p>
    <h1>Shipping production software at team speed, as one developer with AI.</h1>
    <p class="lede">
      I lead AI development work and build agentic systems that plan, write, review, and ship code. Here I write about
      what actually works, what breaks, and how to build software faster without lowering the bar.
    </p>
    <p class="cta-row">
      <a class="button" href="/blog/">Read the writing</a>
      <a class="button ghost" href="/work-with-me/">Work with me</a>
    </p>
  </section>

  <section class="wrap">
    <h2>Latest</h2>
    {posts.length === 0 ? <p>First posts are on the way.</p> : posts.map((post) => <PostCard post={post} />)}
    {posts.length > 0 && <p><a href="/blog/">All posts →</a></p>}
  </section>

  <section class="wrap">
    <Newsletter />
  </section>
</BaseLayout>
